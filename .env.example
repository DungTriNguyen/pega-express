# Chỉ có TÊN biến — không bao giờ commit giá trị thật (repo public).
# Bí mật trên Cloudflare đặt bằng `npx wrangler secret put <TÊN>` hoặc Dashboard.
# Xem docs/deployment.md.

# --- Chung ---
# URL gốc của site (dùng cho canonical, sitemap, OG). Đổi khi gắn domain riêng.
SITE_URL=http://localhost:3000
# development | preview | production — production sẽ CHẶN build nếu còn dữ liệu demo
DEPLOY_ENV=development
# json | api — nguồn dữ liệu của lớp repository
DATA_SOURCE=json
# Khi DATA_SOURCE=api: địa chỉ REST API của backend
API_BASE_URL=

# --- Liên hệ ---
# Link Zalo OA (khi có). Để trống sẽ dùng https://zalo.me/<hotline>
NEXT_PUBLIC_ZALO_OA_URL=
# Link Messenger (desktop)
NEXT_PUBLIC_MESSENGER_URL=https://m.me/pegaexpress

# --- Cloudflare Turnstile (chống spam form) ---
# Để trống ở máy dev sẽ dùng khóa thử nghiệm công khai của Cloudflare (luôn qua).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Sheets (ghi lead) — service account chỉ có quyền sheet "Leads" ---
GOOGLE_SHEETS_LEADS_ID=
GOOGLE_SHEETS_LEADS_RANGE=Leads!A:O
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key dạng PEM, xuống dòng viết \n
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Google Sheets (dữ liệu nội dung, dùng cho scripts/sync-sheets.ts lúc build) ---
GOOGLE_SHEETS_CONTENT_ID=

# --- Email báo lead (Resend) ---
RESEND_API_KEY=
LEAD_EMAIL_TO=pegaexpressvn@gmail.com
LEAD_EMAIL_FROM=

# --- Analytics ---
# Cloudflare Web Analytics (không cookie) — bật sẵn khi có token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# GA4 + Meta Pixel: làm sẵn, mặc định TẮT. Có ID mới bật, và chỉ chạy sau khi khách đồng ý cookie.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
